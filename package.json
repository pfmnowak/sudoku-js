    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.1.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
